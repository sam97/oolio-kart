# Defaults for every setting of both services. Please do not put secrets or
# machine-specific values here. Override them instead, from lowest to highest
# precedence:
#   .env               local development overrides (gitignored)
#   $ENV_FILE          a staging or production file, e.g. ENV_FILE=deploy/staging.env
#   the environment    variables of the same name
# Override files may be partial: they only need the keys they change.

# Shared by kart-api, coupons-job and migrate.
LOG_LEVEL=info
LOG_FORMAT=json
# Local development credentials only. In staging and production, please set
# this from a secret instead.
DATABASE_URL=postgres://kart:kart@localhost:5432/kart?sslmode=disable

# kart-api
ADDR=:8080
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
# key:scope|scope entries, comma-separated.
# TODO: These keys should be in secrets or other data store
API_KEYS=apitest:create_order
# Bounds each coupon lookup in the database.
COUPONS_QUERY_TIMEOUT=2s
# A cache TTL of 0 disables caching of that kind of answer.
COUPON_CACHE_TTL=5m
COUPON_NEGATIVE_CACHE_TTL=1m
COUPON_SETTINGS_CACHE_TTL=1m
CACHE_MAX_ENTRIES=10000
COUPON_RATE_LIMIT=20
COUPON_RATE_WINDOW=1m
ORDER_RATE_LIMIT=10
ORDER_RATE_WINDOW=1m
# CIDRs of reverse proxies whose X-Forwarded-For is trusted, comma-separated.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=*

# coupons-job
# Keep either the .txt or the .gz files here, never both.
COUPONS_DIR=data/coupons
# Bucket files from the last build, about 8 bytes per coupon line. Put them on
# a fast disk.
COUPONS_BUCKET_DIR=data/buckets
# Memory cap for building the valid codes, e.g. 256MiB or 1GiB. Every buffer
# and worker count of the build is sized from it. At least 32MiB.
COUPONS_MEMORY_LIMIT=256MiB
# When to check the files for changes, after the run on start: a cron
# expression such as */5 * * * *, or @every 1m. A check of unchanged files only
# lists them.
COUPONS_SCHEDULE=@every 1m
