# Defaults for every setting of both services. Please do not put secrets or
# machine-specific values here. Override them instead, from lowest to highest
# precedence:
#   .env               local development overrides (gitignored)
#   $ENV_FILE          a staging or production file, e.g. ENV_FILE=deploy/staging.env
#   the environment    variables of the same name
# Override files may be partial: they only need the keys they change.

# Shared by both services.
LOG_LEVEL=info
LOG_FORMAT=json

# kart-api
ADDR=:8080
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s
# key:scope|scope entries, comma-separated.
# TODO: These keys should be in secrets or other data store
API_KEYS=apitest:create_order
COUPONS_URL=http://localhost:8081
COUPONS_TIMEOUT=2s
# A cache TTL of 0 disables caching of that kind of answer.
COUPON_CACHE_TTL=5m
COUPON_NEGATIVE_CACHE_TTL=1m
CACHE_MAX_ENTRIES=10000
COUPON_RATE_LIMIT=20
COUPON_RATE_WINDOW=1m
ORDER_RATE_LIMIT=10
ORDER_RATE_WINDOW=1m
# CIDRs of reverse proxies whose X-Forwarded-For is trusted, comma-separated.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=*

# coupons-server
COUPONS_ADDR=127.0.0.1:8081
# Keep either the .txt or the .gz files here, never both.
COUPONS_DIR=data/coupons
COUPONS_POLL_INTERVAL=2s
COUPONS_DISCOUNT_PERCENT=10
COUPONS_SHUTDOWN_TIMEOUT=10s
